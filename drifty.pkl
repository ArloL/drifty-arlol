/// ArloL GitHub organization desired state.
amends "https://raw.githubusercontent.com/ArloL/drifty/refs/heads/main/config/drifty.pkl"

// ── Shared status checks ──────────────────────────────────────────────────

local checkActions = new StatusCheck {
  context = "check-actions.required-status-check"
  appId = module.githubActionsAppId
}
local codeqlAnalysis = new StatusCheck {
  context = "codeql-analysis.required-status-check"
  appId = module.githubActionsAppId
}
local codeqlCheck = new StatusCheck {
  context = "CodeQL"
  appId = module.githubAdvancedSecurityAppId
}
local ciCheck = new StatusCheck {
  context = "ci.required-status-check"
  appId = module.githubActionsAppId
}
local mainCiCheck = new StatusCheck {
  context = "main.required-status-check"
  appId = module.githubActionsAppId
}
local testCiCheck = new StatusCheck {
  context = "test.required-status-check"
  appId = module.githubActionsAppId
}
local testsCiCheck = new StatusCheck {
  context = "tests.required-status-check"
  appId = module.githubActionsAppId
}
local prCheck = new StatusCheck {
  context = "pr-check.required-status-check"
  appId = module.githubActionsAppId
}
// The SonarQubeCloud app's own "SonarCloud Code Analysis" check is not
// required: it never reports on the dependency bump pull requests the workflow
// skips, and would block those merges forever. The workflow waits for the
// quality gate instead, so the check below fails on a gate failure.
local sonarcloudCheck = new StatusCheck {
  context = "sonarcloud.required-status-check"
  appId = module.githubActionsAppId
}

// ── Shared rulesets ───────────────────────────────────────────────────────

local baseRuleset: Ruleset = new {
  includePatterns { "refs/heads/main" }
  requiredLinearHistory = true
  noForcePushes = true
  requiredStatusChecks { checkActions; codeqlAnalysis; codeqlCheck }
  requiredCodeScanning {
    new CodeScanningTool { tool = "CodeQL" }
    new CodeScanningTool { tool = "zizmor" }
  }
}

// Each variant amends baseRuleset, appending one more required status check.
local ciRuleset: Ruleset = (baseRuleset) {
  requiredStatusChecks { ciCheck }
}

local ciSonarcloudRuleset: Ruleset = (ciRuleset) {
  requiredStatusChecks { sonarcloudCheck }
}

local sonarcloudRuleset: Ruleset = (baseRuleset) {
  requiredStatusChecks { sonarcloudCheck }
}

local mainCiRuleset: Ruleset = (baseRuleset) {
  requiredStatusChecks { mainCiCheck }
}

local mainCiSonarcloudRuleset: Ruleset = (mainCiRuleset) {
  requiredStatusChecks { sonarcloudCheck }
}

local testCiRuleset: Ruleset = (baseRuleset) {
  requiredStatusChecks { testCiCheck }
}

local testsCiRuleset: Ruleset = (baseRuleset) {
  requiredStatusChecks { testsCiCheck }
}

local prCheckRuleset: Ruleset = (baseRuleset) {
  requiredStatusChecks { prCheck }
}

// ── Shared branch protections ─────────────────────────────────────────────

local mainBranchProtection: BranchProtection = new {
  enforceAdmins = true
  requiredLinearHistory = true
  requiredStatusChecks { checkActions; codeqlAnalysis; codeqlCheck }
}

local ciBranchProtection: BranchProtection = (mainBranchProtection) {
  requiredStatusChecks { ciCheck }
}

local ciSonarcloudBranchProtection: BranchProtection = (ciBranchProtection) {
  requiredStatusChecks { sonarcloudCheck }
}

local sonarcloudBranchProtection: BranchProtection = (mainBranchProtection) {
  requiredStatusChecks { sonarcloudCheck }
}

local mainCiBranchProtection: BranchProtection = (mainBranchProtection) {
  requiredStatusChecks { mainCiCheck }
}

local mainCiSonarcloudBranchProtection: BranchProtection = (mainCiBranchProtection) {
  requiredStatusChecks { sonarcloudCheck }
}

local testCiBranchProtection: BranchProtection = (mainBranchProtection) {
  requiredStatusChecks { testCiCheck }
}

local testsCiBranchProtection: BranchProtection = (mainBranchProtection) {
  requiredStatusChecks { testsCiCheck }
}

local prCheckBranchProtection: BranchProtection = (mainBranchProtection) {
  requiredStatusChecks { prCheck }
}

// ── Shared environments ───────────────────────────────────────────────────

// Sonar analyses run on pull request branches too, so this one stays
// unrestricted.
local sonarcloudEnvironment: Environment = new {
  secrets { "SONAR_TOKEN" }
}

// ── Repo templates ────────────────────────────────────────────────────────

local noRulesRepo: Repository = new {
  automatedSecurityFixes = true
  allowMergeCommit = false
  allowSquashMerge = false
  allowAutoMerge = true
  deleteBranchOnMerge = true
  defaultWorkflowPermissions = "read"
  immutableReleases = true
}

local defaultRepo: Repository = (noRulesRepo) {
  branchProtections { ["main"] = mainBranchProtection }
  rulesets { ["main-branch-rules"] = baseRuleset }
}

local pagesSiteTemplate: Repository = (defaultRepo) {
  pages = new {}
}

// Overrides the "main" mapping key in both branchProtections and rulesets.
local mainCiRepoTemplate: Repository = (defaultRepo) {
  branchProtections { ["main"] = mainCiBranchProtection }
  rulesets { ["main-branch-rules"] = mainCiRuleset }
}

local mainCiSonarcloudRepoTemplate: Repository = (mainCiRepoTemplate) {
  branchProtections { ["main"] = mainCiSonarcloudBranchProtection }
  rulesets { ["main-branch-rules"] = mainCiSonarcloudRuleset }
  environments { ["sonarcloud"] = sonarcloudEnvironment }
}

local sonarcloudRepoTemplate: Repository = (defaultRepo) {
  branchProtections { ["main"] = sonarcloudBranchProtection }
  rulesets { ["main-branch-rules"] = sonarcloudRuleset }
  environments { ["sonarcloud"] = sonarcloudEnvironment }
}

local archivedRepo: Repository = new { archived = true }

// ── Repositories ──────────────────────────────────────────────────────────

users {
  ["ArloL"] {
    repositories {
      // Pages sites
      (pagesSiteTemplate) {
        name = "abenteuer-irland"
        description = "Mum's website for Abenteuer Irland"
        homepageUrl = "https://arlol.github.io/abenteuer-irland/"
      }
      (pagesSiteTemplate) {
        name = "angular-playground"
        description = "A playground for the Angular framework"
        homepageUrl = "https://arlol.github.io/angular-playground/"
        branchProtections { ["main"] = prCheckBranchProtection }
        rulesets { ["main-branch-rules"] = prCheckRuleset }
      }
      (pagesSiteTemplate) {
        name = "arlol.github.io"
        description = "This is the source of my GitHub page"
        homepageUrl = "https://arlol.github.io/"
      }
      (pagesSiteTemplate) {
        name = "bulma-playground"
        description = "A playground for the Bulma CSS framework"
        homepageUrl = "https://arlol.github.io/bulma-playground/"
      }
      (pagesSiteTemplate) {
        name = "business-english"
        description = "Mum's website for Business English"
        homepageUrl = "https://arlol.github.io/business-english/"
      }
      (pagesSiteTemplate) {
        name = "demo-html5up-future-imperfect-scroll-padding-top"
        description = "A quick demo of scroll-padding-top"
        homepageUrl = "https://arlol.github.io/demo-html5up-future-imperfect-scroll-padding-top/"
      }
      (pagesSiteTemplate) {
        name = "eclipse-projects"
        description = "Arlo's project catalog for the Eclipse Installer"
        homepageUrl = "https://arlol.github.io/eclipse-projects/"
      }

      // Main CI repos
      (mainCiSonarcloudRepoTemplate) {
        name = "chorito"
        description = "A tool that does some chores in your source code"
        actionsSecrets { "PAT" }
      }
      (mainCiRepoTemplate) {
        name = "cve-playground"
        description = "A playground to see how go works when calling APIs. Specifically NVD."
      }
      (mainCiSonarcloudRepoTemplate) {
        name = "drifty"
        description = "Detect and fix drift of GitHub repository settings"
      }
      (mainCiSonarcloudRepoTemplate) {
        name = "git-dora-lead-time-calculator"
        description =
          "A project to calculate the DORA metric lead time with the info from a git repo"
      }
      (mainCiSonarcloudRepoTemplate) {
        name = "mvnx"
        description = "An experiment with Maven dependencies and dynamic classloading"
      }
      (mainCiSonarcloudRepoTemplate) {
        name = "myprojects-cleaner"
        description = "A java application that runs git clean in a bunch of directories"
      }
      (mainCiSonarcloudRepoTemplate) {
        name = "newlinechecker"
        description = "A sample project to play with GraalVM builds on GitHub Actions"
      }
      (mainCiSonarcloudRepoTemplate) {
        name = "pkl-config-java-native"
        description = "A superset of pkl-config-java that works in native binaries"
      }
      (mainCiSonarcloudRepoTemplate) {
        name = "rss-to-mail"
        description = "Read from RSS feeds and send an email for every new item"
      }
      (mainCiSonarcloudRepoTemplate) {
        name = "template-graal"
        description = "A template for graal projects"
      }
      (mainCiSonarcloudRepoTemplate) {
        name = "template-maven"
        description = "A template for maven projects"
      }
      (mainCiSonarcloudRepoTemplate) {
        name = "wait-for-ports"
        description = "A command-line utility that waits until a port is open"
      }
      (mainCiSonarcloudRepoTemplate) {
        name = "webapp-classloader-test"
        description =
          "This is a test that can be used during integration testing to check for classloader leaks"
      }
      (mainCiSonarcloudRepoTemplate) {
        name = "website-janitor"
        description = "A set of tools that check websites for common misconfigurations or downtime"
      }

      // Individual repos
      (sonarcloudRepoTemplate) {
        name = "advent-of-code"
        description = "My advent of code solutions"
      }
      (defaultRepo) {
        name = "calver-tag-action"
        description =
          "A GitHub Actions action that creates a new version using a CalVer-style derivative and pushes it"
        immutableReleases = true
      }
      (defaultRepo) {
        name = "claude-code-web-environment-setup"
        description = "Setup scripts for Claude Code on the web"
        branchProtections { ["main"] = prCheckBranchProtection }
        rulesets { ["main-branch-rules"] = prCheckRuleset }
      }
      (defaultRepo) {
        name = "configurable-containers"
        description = "One config to route every site to the right container"
        pages = new {}
        branchProtections { ["main"] = ciSonarcloudBranchProtection }
        rulesets { ["main-branch-rules"] = ciSonarcloudRuleset }
        environments {
          // Only release.yaml and ci.yml's prerelease job talk to AMO, and both run
          // on main only, so the credentials never need to be reachable elsewhere.
          ["mozilla"] = new {
            secrets { "WEB_EXT_API_KEY"; "WEB_EXT_API_SECRET" }
            protectedBranches = true
          }
          ["sonarcloud"] = sonarcloudEnvironment
        }
      }
      (defaultRepo) {
        name = "corporate-python"
        description = "A container for executing python in corporate environments"
        actionsSecrets { "DOCKER_HUB_ACCESS_TOKEN"; "DOCKER_HUB_USERNAME" }
      }
      (defaultRepo) {
        name = "dependabot-dockerfile-test"
        description = "A test to see whether dependabot updates dockerfiles with args"
      }
      (defaultRepo) {
        name = "dotfiles"
        description = "My collection of dotfiles used to configure my command line environments"
      }
      (defaultRepo) {
        name = "drifty-arlol"
        description = "The drifty configuration for my GitHub repositories"
        branchProtections { ["main"] = ciBranchProtection }
        rulesets { ["main-branch-rules"] = ciRuleset }
      }
      (defaultRepo) {
        name = "effortful-retrieval-questions"
        description =
          "A collection of effortful retrieval questions of a number of articles I've read"
      }
      (defaultRepo) {
        name = "git-presentation-2018-10"
        description = "Git Präsentation für Vorlesung Industrielle Softwareentwicklung"
      }
      (defaultRepo) {
        name = "homebrew-tap"
        description = "A homebrew tap for my own formulas and casks"
        branchProtections { ["main"] = testsCiBranchProtection }
        rulesets { ["main-branch-rules"] = testsCiRuleset }
      }
      (sonarcloudRepoTemplate) {
        name = "kafka-debugger"
        description = "A small jar utility to test kafka connections"
      }
      (defaultRepo) {
        name = "menubar-scripts"
        description = "A collection of scripts that can run in e.g. xbar, swiftbar, etc."
      }
      (defaultRepo) {
        name = "music-stuff"
        description = "Some spotify and beatunes stuff"
        branchProtections { ["main"] = testCiBranchProtection }
        rulesets { ["main-branch-rules"] = testCiRuleset }
      }
      (defaultRepo) {
        name = "nope-amine"
        description =
          "A firefox extension that slowly increases the time for things to load on reddit.com"
      }
      (defaultRepo) {
        name = "open-webui-runner"
        description = "A small repo to run open-webui locally and stop it after using it"
      }
      (sonarcloudRepoTemplate) {
        name = "postgres-sync-demo"
        description =
          "A demo on how to use triggers, queues, etc. to sync the app's data somewhere else"
      }
      (defaultRepo) {
        name = "python-nc"
        description = "A test to see if I can implement nc's proxy functionality with python"
        branchProtections { ["main"] = testCiBranchProtection }
        rulesets { ["main-branch-rules"] = testCiRuleset }
      }
      (sonarcloudRepoTemplate) {
        name = "sci-fi-movies"
        description =
          "an app to import sci fi movies from rotten tomatoes into a database in order to run queries on them"
      }
      (defaultRepo) {
        name = "tsaf-parser"
        description = "Binary format exploration"
        branchProtections { ["main"] = testCiBranchProtection }
        rulesets { ["main-branch-rules"] = testCiRuleset }
      }
      (defaultRepo) {
        name = "vagrant-ssh-config"
        description = "A vagrant plugin that automatically creates ssh configs for vms"
      }

      (noRulesRepo) {
        name = "nvd-cves"
        description = "All CVEs from the NVD"
        actionsSecrets { "NVD_API_KEY" }
      }

      // Archived repos
      for (
        repoName in
          List(
            "actions",
            "actions-checkout-fetch-depth-demo",
            "airmac",
            "beatunes-keytocomment",
            "campuswoche-2018-webseiten-steuern",
            "chop-kata",
